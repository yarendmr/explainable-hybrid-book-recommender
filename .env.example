LLM_PROVIDER=huggingface
LLM_MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
HF_TOKEN= 
HF_MAX_NEW_TOKENS=90

DATA_MODE=amazon
AMAZON_CATEGORY=Books
AMAZON_MAX_PRODUCTS=1000
AMAZON_MAX_INTERACTIONS=10000
AMAZON_MIN_USER_INTERACTIONS=3
AMAZON_MIN_ITEM_INTERACTIONS=3

# Books çok büyük olduğu için streaming ile ilk N review/meta taranır.
# Gerekirse artırılabilir; ilk test için bu değerler yeterlidir.
AMAZON_REVIEW_STREAM_LIMIT=300000
AMAZON_META_STREAM_LIMIT=1200000

DEFAULT_K=8
MAX_K=20
